#include "SPI.h"

#define SPI_CLK_EN					(1U<<12)
#define GPIOA_CLK_EN				(1U<<0)
#define SR_TXE						(1U<<1)
#define SR_RXNE						(1U<<0)
#define SR_BSY						(1U<<7)
#define GPIOB_CLK_EN (1U<<1)
#define SPI2_CLK_EN (1U<<14)



/*
	PA5 -> SPI1_SCK
	PA6 -> SPI1_MISO
	PA7 -> SPI1_MOSI
	For selecting slave(CS) we can use any pin so PA9
*/

void spi_gpio_init(void)
{
	/*Enable Clock Access to GPIO*/
	RCC->AHB1ENR |= GPIOA_CLK_EN;

	/*PA5,6,7 to Alternate Function mode*/
	//PA5
	GPIOA->MODER &= ~(1U<<10);
	GPIOA->MODER |=  (1U<<11);
	//PA6

	GPIOA->MODER &= ~(1U<<12);
	GPIOA->MODER |=  (1U<<13);
	//PA7

	GPIOA->MODER &= ~(1U<<14);
	GPIOA->MODER |=  (1U<<15);

	//PA9 TO OUTPUT MODE
	//Because We need to set the pin high and low
	GPIOA->MODER &= ~(1U<<19);
	GPIOA->MODER |=  (1U<<18);

	//Setting These pins to AF5
	//PA5
	GPIOA->AFR[0] |=  (1U<<20);
	GPIOA->AFR[0] &= ~(1U<<21);
	GPIOA->AFR[0] |=  (1U<<22);
	GPIOA->AFR[0] &= ~(1U<<23);

	//PA6
	GPIOA->AFR[0] |=  (1U<<24);
	GPIOA->AFR[0] &= ~(1U<<25);
	GPIOA->AFR[0] |=  (1U<<26);
	GPIOA->AFR[0] &= ~(1U<<27);
	//PA7

	GPIOA->AFR[0] |=  (1U<<28);
	GPIOA->AFR[0] &= ~(1U<<29);
	GPIOA->AFR[0] |=  (1U<<30);
	GPIOA->AFR[0] &= ~(1U<<31);

}


void spi2_gpio_init(void)
{
	RCC->AHB1ENR |= GPIOB_CLK_EN;

	// PB13, PB14, PB15 to Alternate Function
	GPIOB->MODER &= ~(1U<<26 | 1U<<28 | 1U<<30);
	GPIOB->MODER |=  (1U<<27 | 1U<<29 | 1U<<31);

	// Set AF5 for SPI2
	GPIOB->AFR[1] |=  (1U<<20 | 1U<<24 | 1U<<28);
	GPIOB->AFR[1] &= ~(1U<<21 | 1U<<25 | 1U<<29);
	GPIOB->AFR[1] |=  (1U<<22 | 1U<<26 | 1U<<30);
	GPIOB->AFR[1] &= ~(1U<<23 | 1U<<27 | 1U<<31);
}

void spi_config(void)
{
	/*Enable clock access to SPI1*/
	RCC->APB2ENR |= SPI_CLK_EN;

	//Sec26.7.1
	/*Setting the Baud rate */
	/*BR Bit 3,4,5*/
	/*Set Clock	to fpclk/4 */
	//The default speed is 16MHz
	SPI1->CR1 |=  (1U<<3);
	SPI1->CR1 &= ~(1U<<4);
	SPI1->CR1 &= ~(1U<<5);

	/*
	 * CPOL (Clock Polarity)
	- Defines the idle state of the clock line (SCLK):
	- CPOL = 0 → Clock is low when idle.
	- CPOL = 1 → Clock is high when idle.
	This affects the baseline level of the clock signal when no data is being transferred.

 	 CPHA (Clock Phase)
	- Determines which clock edge is used for data sampling and shifting:
	- CPHA = 0 → Data is sampled on the first edge (after the idle state changes).
	- CPHA = 1 → Data is sampled on the second edge.
	 * */
	/*Set CPOL and CPHA to 1*/
	SPI1->CR1 |= (1U<<0);
	SPI1->CR1 |= (1U<<1);

	/*Enable Full Duplex*/
	SPI1->CR1 &= ~(1U<<10);

	/*Set MSB First*/
	SPI1->CR1 &= ~(1U<<7);

	/*Set mode to MASTER*/
	SPI1->CR1 |= (1U<<2);

	/*Set 8 bit data mode*/
	SPI1->CR1 &= ~(1U<<11);

	/*Select software slave management by
	 * setting SSM=1 and SSI=1*/
	SPI1->CR1 |= (1<<8);
	SPI1->CR1 |= (1<<9);

	/*Enable SPI module*/
	SPI1->CR1 |= (1<<6);

}

void spi1_transmit(uint8_t *data,uint32_t size)
{
	uint32_t i=0;
	uint8_t temp;

	while(i<size)
	{
		/*Wait until TXE is set*/
		while(!(SPI1->SR & (SR_TXE))){}

		/*Write the data to the data register*/
		SPI1->DR = data[i];
		i++;
	}
	/*Wait until TXE is set*/
	while(!(SPI1->SR & (SR_TXE))){}

	/*Wait for BUSY flag to reset*/
	while((SPI1->SR & (SR_BSY))){}

	/*Clear OVR flag*/
	temp = SPI1->DR;
	temp = SPI1->SR;
}

void spi1_receive(uint8_t *data,uint32_t size)
{
	while(size)
	{
		/*Send dummy data*/
		SPI1->DR =0;

		/*Wait for RXNE flag to be set*/
		while(!(SPI1->SR & (SR_RXNE))){}

		/*Read data from data register*/
		*data++ = (SPI1->DR);
		size--;
	}
}


void cs_enable(void)
{
	GPIOA->ODR &=~(1U<<9);

}

/*Pull high to disable*/
void cs_disable(void)
{
	GPIOA->ODR |=(1U<<9);
}

